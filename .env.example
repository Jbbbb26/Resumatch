# Copy to .env for local development. Never commit the real .env.

# ---- Backend (server.js) -> set these in Railway > Variables ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# Frontend origins allowed to call the API (comma-separated). Leave empty locally.
CORS_ORIGINS=https://your-app.vercel.app,*.vercel.app,http://localhost:5173

# ---- Frontend (Vite) -> set these in Vercel > Settings > Environment Variables ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Railway API URL, no trailing slash. Leave empty locally (vite proxies /api to :3000).
VITE_API_URL=https://your-api.up.railway.app
