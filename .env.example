# Copy to .env for local development. Never commit the real .env.

# ---- Backend (server.js) -> set these in Railway > Variables ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# Used by POST /api/login to sign users in (same value as VITE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: secret for hashing emails/IPs in the sign-in attempt limits (defaults to the service key).
# LOGIN_HASH_SECRET=any-long-random-string
# Frontend origins allowed to call the API (comma-separated). Leave empty locally.
CORS_ORIGINS=https://your-app.vercel.app,*.vercel.app,http://localhost:5173
# Optional: match-analysis similarity calibration (see matchAnalysis.js). Defaults shown.
# MATCH_SIM_FLOOR=0.68
# MATCH_SIM_CEILING=0.85
# MATCH_SIM_MET=0.80
# MATCH_SIM_PARTIAL=0.73

# ---- Frontend (Vite) -> set these in Vercel > Settings > Environment Variables ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Railway API URL, no trailing slash. Leave empty locally (vite proxies /api to :3000).
VITE_API_URL=https://your-api.up.railway.app
# Your live site, no trailing slash. Share buttons always link here (even when testing on localhost).
VITE_PUBLIC_SITE_URL=https://your-app.vercel.app
